# Microsoft Entra app registration for the SharePoint MCP server.
# Copy this file to `.env` and fill in your values.

# Required
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Optional: if set, the server runs in app-only (client credentials) mode.
# Leave unset to use delegated auth (device code flow, token cached under %APPDATA%).
# AZURE_CLIENT_SECRET=
